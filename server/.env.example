# Copy this file to .env and fill it in. The server reads .env when it starts; restart it after a change.

# Port the server listens on
PORT=8090

# Password for the admin at /admin. Changing it signs everyone out.
ADMIN_PASSWORD=

# Mailbox the contact forms send from (outgoing mail / SMTP). Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=web@bmb-green.cz
SMTP_PASS=

# Where the messages go: enquiries and everything else / outages and technical support
MAIL_TO_POPTAVKY=smlouva@bmb-green.cz
MAIL_TO_VYPADKY=vypadky@bmb-green.cz
